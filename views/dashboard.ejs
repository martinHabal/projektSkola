<!DOCTYPE html>
<html lang="cs">

    <style>
        .odevzdano-status {
               
            /* color: #166534; */
            background-color: #1fc752;
        }
        /* .server-status.online {
            background: #dcfce7;
            color: #166534;
        }
        .server-status.offline {
            background: #fee2e2;
            color: #991b1b;
        }
        .server-status.checking {
            background: #fef3c7;
            color: #92400e;
